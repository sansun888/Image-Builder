#   uci commit network
# fi

# Configure ttyd
if [[ -n "$ttyd_auto_login" ]]; then
  uci set ttyd.@ttyd[0].command="$ttyd_auto_login"
  uci commit ttyd
fi

if [[ -n "$shell" ]]; then
  sed -i 's|/bin/ash|'"$shell"'|g' /etc/passwd
fi

echo "All done!"
