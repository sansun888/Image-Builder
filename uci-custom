# Beware! This script will be in /rom/etc/uci-defaults/ as part of the image.
# Uncomment lines to apply:

# pppoe_username="123"
# pppoe_password="456"
# wan_device="eth0"
#   luci-i18n-adbyby-plus-zh-cn   luci-i18n-ddns-go-zh-cn
# ttyd_auto_login="/bin/login -f root"
# shell="/bin/bash"

# log potential errors
exec >/tmp/setup.log 2>&1

uci set system.@system[0].timezone='CST-8'
uci set system.@system[0].zonename='Asia/Shanghai'
uci set system.@system[0].hostname='Ls'
uci set luci.main.lang="zh_cn"
uci commit system

# Configure LAN

  uci set network.lan.ipaddr="192.168.2.3/24"
   uci set network.globals.ula_prefix=''
  uci commit network

  # uci set dhcp.lan.ignore="0"
  uci set dhcp.lan.ra='relay'
  uci set dhcp.lan.ndp='relay'
  uci set dhcp.lan.dhcpv6='relay'
  uci set dhcp.lan.ra_management='1'
  uci set dhcp.lan.ra_default='1'

  uci set dhcp.wan.ra='relay'
  uci set dhcp.wan.ndp='relay'
  uci set dhcp.wan.dhcpv6='relay'
  uci set dhcp.wan.ra_management='1'
  uci set dhcp.wan.ra_default='1'
  # uci set dhcp.lan.ra='0'
  # uci set dhcp.lan.ndp='0'
  # uci set dhcp.lan.dhcpv6='0'
  # uci set dhcp.lan.ra_management='0'
  # uci set dhcp.lan.ra_default='0'
  uci commit dhcp

 
# Configure WLAN

  uci set wireless.@wifi-device[0].disabled= "0"
  uci set wireless.@wifi-iface[0].ssid="5G"
  uci set wireless.@wifi-iface[0].hidden="1"
  uci set wireless.@wifi-device[1].disabled= "1"
  uci set wireless.@wifi-iface[1].ssid="5G"
  uci set wireless.@wifi-iface[1].hidden="1"
  uci commit wireless


